# Sof Expo Marketing System — muhit sozlamalari
# Bu faylni `.env` ga nusxalang va qiymatlarni to'ldiring. `.env` GITGA TUSHMAYDI.

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...

# Model sozlamalari (ixtiyoriy — standart qiymatlar kodda)
MODEL_SMART=claude-opus-4-8       # kontent, strategiya, murakkab tahlil
MODEL_CHEAP=claude-haiku-4-5      # klassifikatsiya, boyitish, segmentatsiya

# --- Supabase (CRM) ---
SUPABASE_URL=https://<project>.supabase.co
# Server-side (agentlar) uchun service_role kaliti — MAXFIY, faqat backendda
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Meta Ads (Ad Manager agenti uchun; ixtiyoriy, MCP orqali ham boshqarish mumkin) ---
META_ADS_ACCOUNT_ID=act_...

# --- Umumiy ---
# Standart til: uz | ru | zh
DEFAULT_LANG=uz
# Faol tadbir (outreach/kontent shu tadbirga bog'lanadi)
ACTIVE_EVENT=build-pro-expo
